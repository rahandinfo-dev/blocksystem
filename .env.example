# Server-only: configure these in Vercel's production environment, then redeploy.
# Never prefix these credentials with NEXT_PUBLIC_. Never commit populated values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel KV-compatible fallback, used only when the UPSTASH_* variables are absent.
KV_REST_API_URL=
KV_REST_API_TOKEN=
VERIFICATION_ADMIN_SECRET=
# Canonical HTTPS origin only, with no path/query. Preview hosts are never inferred.
VERIFICATION_PUBLIC_ORIGIN=
# Development only: explicitly opt into single-process local persistence.
# Refused in production and on Vercel. Choose a private directory outside the repo.
VERIFICATION_DEV_DIRECTORY=
# Authentication: a random server-only value of 32+ characters. Redeploy after changes.
AUTH_SESSION_SECRET=
# Set these only once to securely bootstrap the initial administrator, then remove the password.
AUTH_BOOTSTRAP_SUPER_ADMIN_EMAIL=
AUTH_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# Optional but required for production email verification and password-reset delivery.
# Configure a verified sender address in Resend; never expose either value to the browser.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Values above are placeholders only. Do not add secrets to this file.
